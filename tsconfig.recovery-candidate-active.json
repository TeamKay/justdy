{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/lib/prisma": [
        "./lib/prisma.recovery-candidate.ts"
      ],
      "@/lib/generated/prisma": [
        "./lib/generated/prisma-recovery-candidate/client"
      ],
      "@/lib/generated/prisma/*": [
        "./lib/generated/prisma-recovery-candidate/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "node_modules 2",
    "node_modules 2.backup",
    ".next",
    "dist",
    "build",
    "recovery-backups"
  ]
}
