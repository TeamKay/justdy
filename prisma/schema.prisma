model UploadedMedia {
  id         String               @id @default(cuid())
  uploaderId String
  storageKey String               @unique @map("uploadThingKey")
  url        String               @db.Text
  fileName   String
  mimeType   String
  type       UploadedMediaType
  purpose    UploadedMediaPurpose @default(GENERAL)
  sizeBytes  BigInt
  status     UploadedMediaStatus  @default(UPLOADED)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  uploader User              @relation("UploadedMediaUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  posts    SocialPostMedia[]

  @@index([uploaderId, createdAt])
  @@index([status, createdAt])
  @@index([purpose, status])
  @@map("uploaded_media")
}

model SocialPost {
  id              String               @id @default(cuid())
  authorId        String
  content         String?              @db.Text
  visibility      SocialPostVisibility @default(FOLLOWERS)
  layout          SocialPostLayout     @default(TEXT_TOP)
  status          SocialPostStatus     @default(DRAFT)
  postType        SocialPostType       @default(GENERAL)
  feedPriority    Int                  @default(0)
  commentsEnabled Boolean              @default(true)
  publishedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  author             User                  @relation("SocialPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  media              SocialPostMedia[]
  comments           SocialComment[]
  reactions          SocialReaction[]
  bookmarks          SocialBookmark[]
  videoWatchSessions VideoWatchSession[]
  dismissals         SocialPostDismissal[]
  shares             SocialPostShare[]
  challenge          SocialChallenge?

  @@index([authorId, createdAt])
  @@index([status, visibility, publishedAt])
  @@index([status, feedPriority, publishedAt])
  @@map("social_post")
}

model SocialChallenge {
  id          String                @id @default(cuid())
  postId      String                @unique
  createdById String
  opensAt     DateTime              @default(now())
  closesAt    DateTime
  maxScore    Int                   @default(100)
  status      SocialChallengeStatus @default(OPEN)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  post         SocialPost                   @relation(fields: [postId], references: [id], onDelete: Cascade)
  creator      User                         @relation("SocialChallengeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants SocialChallengeParticipant[]
  submissions  SocialChallengeSubmission[]

  @@index([status, opensAt, closesAt])
  @@map("social_challenge")
}

model SocialChallengeParticipant {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  joinedAt    DateTime @default(now())

  challenge SocialChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId, joinedAt])
  @@index([challengeId, joinedAt])
  @@map("social_challenge_participant")
}

model SocialChallengeSubmission {
  id          String                          @id @default(cuid())
  challengeId String
  userId      String
  answer      String                          @db.Text
  status      SocialChallengeSubmissionStatus @default(PENDING)
  score       Int?
  feedback    String?                         @db.Text
  gradedById  String?
  submittedAt DateTime                        @default(now())
  gradedAt    DateTime?
  updatedAt   DateTime                        @updatedAt

  challenge SocialChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  learner   User            @relation("SocialChallengeSubmissionLearner", fields: [userId], references: [id], onDelete: Cascade)
  grader    User?           @relation("SocialChallengeSubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([challengeId, userId])
  @@index([challengeId, status, submittedAt])
  @@index([userId, submittedAt])
  @@index([gradedById, gradedAt])
  @@map("social_challenge_submission")
}

model SocialPostMedia {
  id        String   @id @default(cuid())
  postId    String
  mediaId   String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  post  SocialPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  media UploadedMedia @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([postId, mediaId])
  @@unique([postId, position])
  @@index([mediaId])
  @@map("social_post_media")
}

model SocialComment {
  id        String              @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  content   String              @db.Text
  status    SocialCommentStatus @default(VISIBLE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  post    SocialPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User            @relation("SocialCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent  SocialComment?  @relation("SocialCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies SocialComment[] @relation("SocialCommentReplies")

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId, createdAt])
  @@map("social_comment")
}

model SocialPostShare {
  id       String   @id @default(cuid())
  postId   String
  userId   String
  sharedAt DateTime @default(now())

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, sharedAt])
  @@index([userId, sharedAt])
  @@map("social_post_share")
}

model SocialReaction {
  id        String             @id @default(cuid())
  postId    String
  userId    String
  type      SocialReactionType @default(LIKE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("social_reaction")
}

model SocialPostDismissal {
  userId      String
  postId      String
  dismissedAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("social_post_dismissal")
}

model SocialFollow {
  id          String             @id @default(cuid())
  followerId  String
  followingId String
  status      SocialFollowStatus @default(ACCEPTED)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  follower  User @relation("SocialFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("SocialFollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, status, createdAt])
  @@index([followerId, status, createdAt])
  @@map("social_follow")
}

model SocialBookmark {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("social_bookmark")
}

model SocialBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("SocialBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("SocialBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("social_block")
}

model SocialReport {
  id         String                 @id @default(cuid())
  reporterId String
  reviewerId String?
  targetType SocialReportTargetType
  targetId   String
  reason     SocialReportReason
  details    String?                @db.Text
  status     SocialReportStatus     @default(OPEN)
  reviewedAt DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  reporter User  @relation("SocialReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer User? @relation("SocialReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@map("social_report")
}

model SocialModerationAction {
  id          String                     @id @default(cuid())
  moderatorId String
