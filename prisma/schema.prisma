generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                        @id @default(cuid())
  name                       String
  email                      String                        @unique
  emailVerified              Boolean                       @default(false)
  role                       String?                       @default("Learner")
  imageUrl                   String?
  phoneNumber                String?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  stripeCustomerId           String?                       @unique
  onboardingCompleted        Boolean                       @default(false)
  status                     UserStatus                    @default(Active)
  lastLoginAt                DateTime?
  verificationStatus         VerificationStatus            @default(Pending)
  canCreateResources         Boolean                       @default(false)
  canLearn                   Boolean                       @default(true)
  canManageChildren          Boolean                       @default(false)
  canManageSchool            Boolean                       @default(false)
  canPublish                 Boolean                       @default(false)
  canSell                    Boolean                       @default(false)
  canTeach                   Boolean                       @default(false)
  canTutor                   Boolean                       @default(false)
  aiAssets                   AIAsset[]
  aiConversations            AIConversation[]
  aiGenerations              AIGeneration[]
  aiMessages                 AIMessage[]
  aiProjects                 AIProject[]
  educatorAppointments       Appointment[]                 @relation("EducatorAppointments")
  learnerAppointments        Appointment[]                 @relation("LearnerAppointments")
  availabilities             Availability[]
  educatorBookings           Booking[]                     @relation("EducatorBookings")
  studentBookings            Booking[]                     @relation("StudentBookings")
  classroomStudents          ClassroomStudent[]
  classroomTeachers          ClassroomTeacher[]
  connectionsTo              Connection[]                  @relation("ConnectionReceiver")
  connectionsFrom            Connection[]                  @relation("ConnectionRequester")
  courses                    Course[]
  courseEnrollments          CourseEnrollment[]            @relation("CourseLearner")
  creatorProfile             CreatorProfile?
  creditTransactions         CreditTransaction[]
  enrollment                 Enrollment[]
  enrollmentProgress         EnrollmentProgress[]
  facilitatorProfile         FacilitatorProfile?
  familyMemberships          FamilyMember[]
  following                  Follow[]                      @relation("FollowingUser")
  followers                  Follow[]                      @relation("FollowedUser")
  investments                Investment[]
  investmentAccounts         InvestmentAccount[]
  investmentAssets           InvestmentAsset[]
  investmentAuditLogs        InvestmentAuditLog[]
  investmentFXRates          InvestmentFXRate[]
  investmentGoals            InvestmentGoal[]
  investmentHoldings         InvestmentHolding[]
  investmentSnapshots        InvestmentPortfolioSnapshot[]
  investmentPrices           InvestmentPrice[]
  investmentReports          InvestmentReport[]
  investmentTransactions     InvestmentTransaction[]
  learningActivities         LearningActivity[]
  learningProfile            LearningProfile?
  lessonProgress             LessonProgress[]
  organizationOwnerships     Organization[]
  organizationMemberships    OrganizationMembership[]
  payout                     Payout[]
  pendingEnrollments         PendingEnrollment[]
  products                   Product[]
  purchases                  Purchase[]
  resources                  Resource[]
  services                   Service[]
  studentProfile             StudentProfile?
  subscription               Subscription?
  teachingProfile            TeachingProfile?
  transaction                Transaction[]
  tutoringBookingsAsCustomer TutoringBooking[]             @relation("TutoringBookingCustomer")
  tutoringBookingsAsTutor    TutoringBooking[]             @relation("TutoringBookingTutor")
  educatorTutoringSessions   TutoringSession[]             @relation("EducatorTutoringSessions")
  learnerTutoringSessions    TutoringSession[]             @relation("LearnerTutoringSessions")
  tutoringSlots              TutoringSlot[]
  capabilities               UserCapability[]
  credits                    UserCredit?
  permissions                UserPermission[]
  roles                      UserRole[]
  videoGenerations           VideoGeneration[]
  whitrboard                 Whiteboard[]
  accounts                   Account[]
  sessions                   Session[]
  recurringAvailabilities    RecurringAvailability[]

  @@map("user")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  permissions RolePermission[]
  users       UserRole[]
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Permission {
  id    String           @id @default(cuid())
  name  String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model FacilitatorProfile {
  userId             String             @id
  specialty          String?
  experience         Int?
  credentialUrl      String?
  description        String?
  verificationStatus VerificationStatus @default(Pending)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model PendingEnrollment {
  id              String                  @id @default(cuid())
  name            String
  email           String
  phoneNumber     String?
  gradeLevel      String
  subject         String
  enrollmentType  EnrollmentTrack
  topic           String?
  sessionDate     DateTime
  startTime       DateTime
  endTime         DateTime
  educatorId      String?
  amount          Int
  stripeSessionId String?                 @unique
  status          PendingEnrollmentStatus @default(Pending)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  educator        User?                   @relation(fields: [educatorId], references: [id])

  @@index([email])
  @@index([status])
}

model Appointment {
  id                      String            @id @default(cuid())
  learnerId               String
  educatorId              String
  subject                 String
  gradeLevel              String
  date                    DateTime
  startTime               DateTime
  endTime                 DateTime
  learnerDescription      String?
  status                  AppointmentStatus @default(Scheduled)
  stripeCheckoutSessionId String?
  paymentIntentId         String?
  payoutStatus            PayoutStatus      @default(Unpaid)
  videoSessionId          String?
  videoSessionToken       String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  tutoringSlotId          String?           @unique
  educator                User              @relation("EducatorAppointments", fields: [educatorId], references: [id], onDelete: Cascade)
  learner                 User              @relation("LearnerAppointments", fields: [learnerId], references: [id], onDelete: Cascade)
  tutoringSlot            TutoringSlot?     @relation(fields: [tutoringSlotId], references: [id])
  whiteboard              Whiteboard?

  @@index([status, startTime])
  @@index([educatorId, startTime])
  @@index([learnerId, createdAt])
}

model Product {
  id                 String               @id @default(cuid())
  title              String
  description        String
  price              Int?
  printedPrice       Int?
  stripePriceId      String?              @unique
  slug               String               @unique
  userId             String
  type               ProductType
  status             ProductStatus        @default(Draft)
  duration           Int?
  category           String?
  imageKey           String?
  fileKey            String?
  fileType           String?
  fileSize           Int?
  downloadCount      Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  accessModel        ProductAccessModel   @default(INDIVIDUAL)
  gradeLevel         GradeLevel
  subjectId          String
  topicId            String
  chapters           Chapter[]
  enrollments        Enrollment[]
  enrollmentProgress EnrollmentProgress[]
  subject            Subject              @relation(fields: [subjectId], references: [id])
  topic              Topic                @relation(fields: [topicId], references: [id])
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases          Purchase[]

  @@index([gradeLevel])
  @@index([subjectId])
  @@index([topicId])
  @@index([gradeLevel, subjectId, topicId])
  @@index([gradeLevel, subjectId, topicId, type])
}

model Subject {
  id               String            @id @default(cuid())
  name             String            @unique
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  products         Product[]
  topics           Topic[]
  videoGenerations VideoGeneration[]
}

model Topic {
  id               String            @id @default(cuid())
  name             String
  slug             String
  gradeLevel       GradeLevel
  subjectId        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  products         Product[]
  subject          Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  videoGenerations VideoGeneration[]

  @@unique([subjectId, gradeLevel, slug])
  @@index([gradeLevel, subjectId])
  @@index([gradeLevel, subjectId, slug])
}

model Chapter {
  id        String   @id @default(cuid())
  title     String
  position  Int
  productId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([productId])
  @@index([courseId])
}

model Lesson {
  id             String           @id @default(cuid())
  title          String
  description    String?
  thumbnailKey   String?
  videoKey       String?
  position       Int
  chapterId      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  chapter        Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]

  @@index([chapterId])
}

model Purchase {
  id                    String   @id @default(cuid())
  userId                String
  productId             String
  amount                Int
  quantity              Int      @default(1)
  stripeSessionId       String
  stripePaymentIntentId String?
  status                String   @default("Paid")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([stripeSessionId, productId])
  @@index([userId])
  @@index([productId])
}

model Enrollment {
  id        String           @id @default(cuid())
  amount    Int
  status    EnrollmentStatus @default(Pending)
  productId String
  userId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model EnrollmentProgress {
  id           String   @id @default(cuid())
  userId       String
  productId    String
  progress     Float    @default(0)
  lastLessonId String?
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model LessonProgress {
  id        String   @id @default(cuid())
  completed Boolean  @default(false)
  userId    String
  lessonId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Subscription {
  id                   String             @id @default(cuid())
  stripeSubscriptionId String?            @unique
  interval             String
  status               SubscriptionStatus
  planId               PlanType
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  userId               String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payout {
  id          String       @id @default(cuid())
  educatorId  String
  amount      Int
  platformFee Int
  netAmount   Int
  paypalEmail String
  status      PayoutStatus @default(Processing)
  processedBy String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  educator    User         @relation(fields: [educatorId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([educatorId, status])
}

model Transaction {
  id                    String            @id @default(cuid())
  userId                String?
  amount                Int
  stripeSessionId       String?
  stripePaymentIntentId String?
  status                TransactionStatus @default(Pending)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User?             @relation(fields: [userId], references: [id])

  @@index([status])
}

model InvestmentAccount {
  id            String                  @id @default(cuid())
  userId        String
  institution   String                  @default("Fidelity Investments")
  accountNumber String
  accountName   String?
  currency      CurrencyType            @default(USD)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  country       String?
  isActive      Boolean                 @default(true)
  accountType   InvestmentAccountType   @default(BROKERAGE)
  investments   Investment[]
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets        InvestmentAsset[]
  holdings      InvestmentHolding[]
  reports       InvestmentReport[]
  transactions  InvestmentTransaction[]

  @@unique([userId, institution, accountNumber])
  @@index([userId])
  @@index([userId, currency])
  @@index([userId, isActive])
}

model Investment {
  id                    String                    @id @default(cuid())
  name                  String
  tickerOrSymbol        String?
  cusip                 String?
  accountNumber         String?
  accountName           String?
  institution           String?                   @default("Fidelity Investments")
  assetClass            AssetType
  region                RegionType
  currency              CurrencyType
  type                  InvestmentTransactionType
  shares                Float?
  pricePerShare         Float?
  amount                Float
  grossAmount           Float?
  fees                  Float                     @default(0)
  taxes                 Float                     @default(0)
  costBasis             Float?
  realizedGain          Float?
  marketValue           Float?
  unrealizedGain        Float?
  unrealizedGainPercent Float?
  cashBalance           Float?
  exchangeRate          Float                     @default(1)
  amountUSD             Float
  date                  DateTime
  settlementDate        DateTime?
  source                String?
  sourceFile            String?
  importBatchId         String?
  fingerprint           String?                   @unique
  status                StatusType
  notes                 String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  accountId             String?
  userId                String
  investmentAccount     InvestmentAccount?        @relation(fields: [accountId], references: [id])
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, tickerOrSymbol])
  @@index([userId, accountNumber])
  @@index([userId, type])
  @@index([userId, importBatchId])
}

model InvestmentAsset {
  id                 String                  @id @default(cuid())
  userId             String
  accountId          String?
  name               String
  symbol             String?
  tickerOrSymbol     String?
  isin               String?
  cusip              String?
  assetType          InvestmentAssetType
  region             RegionType
  currency           CurrencyType
  exchange           String?
  country            String?
  marketDataSymbol   String?
  marketDataProvider String?
  issuer             String?
  description        String?
  active             Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  account            InvestmentAccount?      @relation(fields: [accountId], references: [id])
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings           InvestmentHolding[]
  prices             InvestmentPrice[]
  transactions       InvestmentTransaction[]

  @@index([userId, symbol])
  @@index([userId, tickerOrSymbol])
  @@index([userId, isin])
  @@index([userId, cusip])
  @@index([userId, assetType])
  @@index([userId, region])
}

model InvestmentTransaction {
  id              String                    @id @default(cuid())
  userId          String
  accountId       String
  assetId         String?
  type            InvestmentTransactionType
  transactionDate DateTime
  settlementDate  DateTime?
  quantity        Decimal?                  @db.Decimal(24, 10)
  price           Decimal?                  @db.Decimal(24, 10)
  grossAmount     Decimal?                  @db.Decimal(24, 10)
  fees            Decimal                   @default(0) @db.Decimal(24, 10)
  taxes           Decimal                   @default(0) @db.Decimal(24, 10)
  netAmount       Decimal?                  @db.Decimal(24, 10)
  currency        CurrencyType
  fxRateToUSD     Decimal                   @default(1) @db.Decimal(24, 12)
  amountUSD       Decimal?                  @db.Decimal(24, 10)
  amountGHS       Decimal?                  @db.Decimal(24, 10)
  faceValue       Decimal?                  @db.Decimal(24, 10)
  maturityDate    DateTime?
  yieldRate       Decimal?                  @db.Decimal(12, 8)
  source          String?
  sourceReference String?
  sourceReportId  String?
  sourceRowNumber Int?
  fingerprint     String                    @unique
  importStatus    InvestmentImportStatus    @default(PENDING)
  notes           String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  account         InvestmentAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset           InvestmentAsset?          @relation(fields: [assetId], references: [id])
  sourceReport    InvestmentReport?         @relation(fields: [sourceReportId], references: [id])
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, transactionDate])
  @@index([accountId, transactionDate])
  @@index([assetId, transactionDate])
  @@index([accountId, type])
  @@index([sourceReportId])
  @@index([importStatus])
}

model InvestmentHolding {
  id                String            @id @default(cuid())
  userId            String
  accountId         String
  assetId           String
  quantity          Decimal           @default(0) @db.Decimal(24, 10)
  averageCost       Decimal?          @db.Decimal(24, 10)
  costBasis         Decimal           @default(0) @db.Decimal(24, 10)
  currentPrice      Decimal?          @db.Decimal(24, 10)
  marketValue       Decimal           @default(0) @db.Decimal(24, 10)
  realizedGain      Decimal           @default(0) @db.Decimal(24, 10)
  unrealizedGain    Decimal           @default(0) @db.Decimal(24, 10)
  unrealizedGainPct Decimal?          @db.Decimal(18, 8)
  incomeReceived    Decimal           @default(0) @db.Decimal(24, 10)
  currency          CurrencyType
  marketValueUSD    Decimal?          @db.Decimal(24, 10)
  marketValueGHS    Decimal?          @db.Decimal(24, 10)
  lastPriceAt       DateTime?
  lastCalculatedAt  DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  account           InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset             InvestmentAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, assetId])
  @@index([userId, assetId])
  @@index([userId, accountId])
  @@index([userId, updatedAt])
}

model InvestmentPrice {
  id         String          @id @default(cuid())
  userId     String
  assetId    String
  price      Decimal         @db.Decimal(24, 10)
  currency   CurrencyType
  asOf       DateTime
  source     String
  isRealtime Boolean         @default(false)
  createdAt  DateTime        @default(now())
  asset      InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assetId, asOf])
  @@index([userId, assetId, asOf])
  @@index([assetId, asOf])
}

model InvestmentFXRate {
  id        String       @id @default(cuid())
  userId    String
  base      CurrencyType
  quote     CurrencyType
  rate      Decimal      @db.Decimal(24, 12)
  asOf      DateTime
  source    String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, base, quote, asOf])
  @@index([base, quote, asOf])
}

model InvestmentReport {
  id                 String                  @id @default(cuid())
  userId             String
  accountId          String
  fileName           String
  storageKey         String?
  mimeType           String?
  fileSizeBytes      Int?
  sha256             String?
  reportType         InvestmentReportType
  statementStartDate DateTime?
  statementEndDate   DateTime?
  uploadedAt         DateTime                @default(now())
  processedAt        DateTime?
  importStatus       InvestmentImportStatus  @default(PENDING)
  transactionCount   Int                     @default(0)
  importedCount      Int                     @default(0)
  duplicateCount     Int                     @default(0)
  rejectedCount      Int                     @default(0)
  errorMessage       String?
  metadata           Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  account            InvestmentAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       InvestmentTransaction[]

  @@index([userId, uploadedAt])
  @@index([accountId, uploadedAt])
  @@index([importStatus])
  @@index([sha256])
}

model InvestmentPortfolioSnapshot {
  id                   String       @id @default(cuid())
  userId               String
  snapshotDate         DateTime
  reportingCurrency    CurrencyType @default(USD)
  totalValue           Decimal      @default(0) @db.Decimal(24, 10)
  cashValue            Decimal      @default(0) @db.Decimal(24, 10)
  investedValue        Decimal      @default(0) @db.Decimal(24, 10)
  costBasis            Decimal      @default(0) @db.Decimal(24, 10)
  realizedGain         Decimal      @default(0) @db.Decimal(24, 10)
  unrealizedGain       Decimal      @default(0) @db.Decimal(24, 10)
  dividendsAndInterest Decimal      @default(0) @db.Decimal(24, 10)
  feesAndTaxes         Decimal      @default(0) @db.Decimal(24, 10)
  contributions        Decimal      @default(0) @db.Decimal(24, 10)
  withdrawals          Decimal      @default(0) @db.Decimal(24, 10)
  timeWeightedReturn   Decimal?     @db.Decimal(18, 10)
  moneyWeightedReturn  Decimal?     @db.Decimal(18, 10)
  fxRateToUSD          Decimal?     @db.Decimal(24, 12)
  fxRateToGHS          Decimal?     @db.Decimal(24, 12)
  createdAt            DateTime     @default(now())
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapshotDate, reportingCurrency])
  @@index([userId, snapshotDate])
}

model InvestmentGoal {
  id                   String       @id @default(cuid())
  userId               String
  name                 String
  targetAmount         Decimal      @db.Decimal(24, 10)
  currency             CurrencyType
  targetDate           DateTime
  startingAmount       Decimal      @default(0) @db.Decimal(24, 10)
  expectedAnnualReturn Decimal?     @db.Decimal(12, 8)
  notes                String?
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, targetDate])
}

model InvestmentAuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model Whiteboard {
  id            String       @id @default(cuid())
  userId        String
  name          String       @default("Untitled Whiteboard")
  data          Json
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  appointmentId String?      @unique
  isStandalone  Boolean      @default(false)
  bookingId     String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
