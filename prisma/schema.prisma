generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                  String                      @id @default(cuid())
  name                                String
  email                               String                      @unique
  emailVerified                       Boolean                     @default(false)
  role                                PlatformRole                @default(LEARNER)
  imageUrl                            String?
  phoneNumber                         String?
  createdAt                           DateTime                    @default(now())
  updatedAt                           DateTime                    @updatedAt
  stripeCustomerId                    String?                     @unique
  onboardingCompleted                 Boolean                     @default(false)
  status                              UserStatus                  @default(Active)
  lastLoginAt                         DateTime?
  lastSeenAt                          DateTime?
  verificationStatus                  VerificationStatus          @default(Pending)
  educatorAppointments                Appointment[]               @relation("EducatorAppointments")
  learnerAppointments                 Appointment[]               @relation("LearnerAppointments")
  availabilities                      Availability[]
  educatorBookings                    Booking[]                   @relation("EducatorBookings")
  studentBookings                     Booking[]                   @relation("StudentBookings")
  classroomStudents                   ClassroomStudent[]
  classroomTeachers                   ClassroomTeacher[]
  onboardingRequestsAssigned          TutoringOnboardingRequest[] @relation("TutoringRequestAssignedTutor")
  tutoringPlansAgreed                 TutoringOnboardingRequest[] @relation("TutoringPlanAgreedBy")
  tutoringOnboardingRequestsAsLearner TutoringOnboardingRequest[] @relation("TutoringOnboardingLearner")
  payout                              Payout[]
  pendingEnrollments                  PendingEnrollment[]
  services                            Service[]
  studentProfile                      StudentProfile?
  transaction                         Transaction[]
  paymentPurchases                    PaymentPurchase[]
  memberships                         Membership[]
  sessionCreditGrants                 SessionCreditGrant[]
  tutoringBookingsAsCustomer          TutoringBooking[]           @relation("TutoringBookingCustomer")
  tutoringBookingsAsTutor             TutoringBooking[]           @relation("TutoringBookingTutor")
  tutoringSlots                       TutoringSlot[]
  whitrboard                          Whiteboard[]
  accounts                            Account[]
  sessions                            Session[]
  videoWatchSessions                  VideoWatchSession[]
  teachingProfile                     TeachingProfile?
  notifications                       Notification[]
  learningActivities                  LearningActivity[]
  dailyChallengesCreated              DailyChallenge[]            @relation("DailyChallengeCreator")
  dailyChallengeAttempts              DailyChallengeAttempt[]     @relation("DailyChallengeAttemptLearner")
  learnerTutoringSessions             TutoringSession[]           @relation("LearnerTutoringSessions")
  educatorTutoringSessions            TutoringSession[]           @relation("EducatorTutoringSessions")
  reviewsWritten                      TutorReview[]               @relation("TutorReviewLearner")
  reviewsReceived                     TutorReview[]               @relation("TutorReviewEducator")
  investmentProfile                   InvestmentProfile?

  // Question Help
  questionsSubmitted  LearnerQuestion[]    @relation("LearnerQuestions")
  questionTutorOffers QuestionTutorOffer[] @relation("QuestionTutorOffers")
  questionsAccepted   LearnerQuestion[]    @relation("QuestionAcceptedTutor")

  // Social identity and publishing
  socialProfile        SocialProfile?
  uploadedMedia        UploadedMedia[]       @relation("UploadedMediaUploader")
  socialPosts          SocialPost[]          @relation("SocialPostAuthor")
  socialComments       SocialComment[]       @relation("SocialCommentAuthor")
  socialReactions      SocialReaction[]
  socialBookmarks      SocialBookmark[]
  socialPostDismissals SocialPostDismissal[]
  socialPostShares     SocialPostShare[]

  // Mathematics challenges
  socialChallengeParticipations    SocialChallengeParticipant[]
  socialChallengeSubmissions       SocialChallengeSubmission[]  @relation("SocialChallengeSubmissionLearner")
  socialChallengesCreated          SocialChallenge[]            @relation("SocialChallengeCreator")
  socialChallengeSubmissionsGraded SocialChallengeSubmission[]  @relation("SocialChallengeSubmissionGrader")

  // Following
  socialFollowsInitiated SocialFollow[] @relation("SocialFollowFollower")
  socialFollowsReceived  SocialFollow[] @relation("SocialFollowFollowing")

  // Safety and moderation
  socialBlocksInitiated   SocialBlock[]            @relation("SocialBlockBlocker")
  socialBlocksReceived    SocialBlock[]            @relation("SocialBlockBlocked")
  socialReportsFiled      SocialReport[]           @relation("SocialReportReporter")
  socialReportsReviewed   SocialReport[]           @relation("SocialReportReviewer")
  socialModerationActions SocialModerationAction[] @relation("SocialModerationActor")

  // Guardian relationships
  guardianshipsInitiated GuardianLink[] @relation("GuardianLinkGuardian")
  guardianshipsReceived  GuardianLink[] @relation("GuardianLinkLearner")

  marketingContact          MarketingContact?
  marketingCampaignsCreated MarketingCampaign[]

  @@index([status, lastSeenAt])
  @@map("user")
}

model TeachingProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline           String?
  specialty          String?
  experience         Int?
  credentialUrl      String?
  description        String?            @db.Text
  verificationStatus VerificationStatus @default(Pending)
  hourlyRate         Int?
  currency           CurrencyType       @default(USD)
  subjects           Json?
  gradeLevels        Json?
  services           Service[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model FacilitatorProfile {
  userId             String             @id
  specialty          String?
  experience         Int?
  credentialUrl      String?
  description        String?
  verificationStatus VerificationStatus @default(Pending)
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model PendingEnrollment {
  id              String                  @id @default(cuid())
  name            String
  email           String
  phoneNumber     String?
  gradeLevel      String
  subject         String
  enrollmentType  EnrollmentTrack
  topic           String?
  sessionDate     DateTime
  startTime       DateTime
  endTime         DateTime
  educatorId      String?
  amount          Int
  stripeSessionId String?                 @unique
  status          PendingEnrollmentStatus @default(Pending)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  educator        User?                   @relation(fields: [educatorId], references: [id])

  @@index([email])
  @@index([status])
}

model Appointment {
  id                      String            @id @default(cuid())
  learnerId               String
  educatorId              String
  subject                 String
  gradeLevel              String
  date                    DateTime
  startTime               DateTime
  endTime                 DateTime
  learnerDescription      String?
  status                  AppointmentStatus @default(Scheduled)
  stripeCheckoutSessionId String?
  paymentIntentId         String?
  payoutStatus            PayoutStatus      @default(Unpaid)
  videoSessionId          String?
  videoSessionToken       String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  tutoringSlotId          String?           @unique
  educator                User              @relation("EducatorAppointments", fields: [educatorId], references: [id], onDelete: Cascade)
  learner                 User              @relation("LearnerAppointments", fields: [learnerId], references: [id], onDelete: Cascade)
  tutoringSlot            TutoringSlot?     @relation(fields: [tutoringSlotId], references: [id])
  whiteboard              Whiteboard?

  @@index([status, startTime])
  @@index([educatorId, startTime])
  @@index([learnerId, createdAt])
}

model Payout {
  id          String       @id @default(cuid())
  educatorId  String
  amount      Int
  platformFee Int
  netAmount   Int
  paypalEmail String
  status      PayoutStatus @default(Processing)
  processedBy String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  educator    User         @relation(fields: [educatorId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([educatorId, status])
}

model Transaction {
  id                    String            @id @default(cuid())
  userId                String?
  amount                Int
  stripeSessionId       String?
  stripePaymentIntentId String?
  status                TransactionStatus @default(Pending)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User?             @relation(fields: [userId], references: [id])

  @@index([status])
}

model Whiteboard {
  id            String       @id @default(cuid())
  userId        String
  name          String       @default("Untitled Whiteboard")
  data          Json
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  appointmentId String?      @unique
  isStandalone  Boolean      @default(false)
  bookingId     String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  booking       Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isStandalone])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  eventKey    String    @unique
  type        String
  title       String
  message     String    @db.Text
  href        String?
  readAt      DateTime?
  emailStatus String    @default("SKIPPED_DISABLED")
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Service {
  id                String            @id @default(cuid())
  providerId        String
  teachingProfileId String?
  teachingProfile   TeachingProfile?  @relation(fields: [teachingProfileId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  type              ServiceType       @default(TUTORING)
  durationMinutes   Int?
  price             Int?
  currency          CurrencyType      @default(USD)
  status            ServiceStatus     @default(Draft)
  subject           String?
  gradeLevels       Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  bookings          Booking[]
  tutoringSessions  TutoringSession[]
  provider          User              @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, status])
  @@index([type, status])
}

enum AvailabilityType {
  ONE_OFF
  RECURRING
  OCCURRENCE
}

model Availability {
  id         String           @id @default(cuid())
  educatorId String
  educator   User             @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  type       AvailabilityType @default(ONE_OFF)

  // Concrete one-off slots and generated bookable occurrences.
  startTime DateTime?
  endTime   DateTime?

  // Weekly recurring schedule fields.
  dayOfWeek         Int?
  weeklyStartTime   String?
  weeklyEndTime     String?
  timeZone          String   @default("UTC")
  active            Boolean  @default(true)
  isAlwaysAvailable Boolean  @default(false)
  excludedDates     String[] @default([])

  // OCCURRENCE records point back to the RECURRING record through this key.
  recurrenceKey  String?
  occurrenceDate String?

  status    SlotStatus @default(Available)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  bookings  Booking[]

  @@unique([recurrenceKey, occurrenceDate])
  @@index([educatorId, startTime])
  @@index([educatorId, type])
  @@index([educatorId, dayOfWeek])
  @@index([educatorId, active])
  @@index([status, startTime])
}

model Booking {
  id                String                     @id @default(cuid())
  studentId         String
  educatorId        String
  serviceId         String?
  availabilityId    String?
  startTime         DateTime
  endTime           DateTime
  subject           String?
  gradeLevel        String?
  status            BookingStatus              @default(Scheduled)
  description       String?
  stripeSessionId   String?
  paymentIntentId   String?
  payoutStatus      PayoutStatus               @default(Unpaid)
  videoSessionId    String?
  videoSessionToken String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  availability      Availability?              @relation(fields: [availabilityId], references: [id], onDelete: SetNull)
  educator          User                       @relation("EducatorBookings", fields: [educatorId], references: [id], onDelete: Cascade)
  service           Service?                   @relation(fields: [serviceId], references: [id])
  student           User                       @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  whiteboard        Whiteboard?
  tutoringSession   TutoringSession?
  reminders         TutoringReminder[]
  tutorReview       TutorReview?
  onboardingSession TutoringOnboardingSession?
  creditRedemption  SessionCreditRedemption?

  @@index([studentId, startTime])
  @@index([educatorId, startTime])
  @@index([status, startTime])
  @@index([availabilityId])
}

model TutoringReminder {
  id        String               @id @default(cuid())
  bookingId String
  type      TutoringReminderType
  sentAt    DateTime             @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, type])
  @@index([type, sentAt])
}

enum TutoringReminderType {
  TWENTY_FOUR_HOURS
  ONE_HOUR
  TEN_MINUTES
}

model Classroom {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  description    String?
  gradeLevel     String?
  subject        String?
  schoolYear     String?
  status         ClassroomStatus    @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  students       ClassroomStudent[]
  teachers       ClassroomTeacher[]

  @@index([organizationId, gradeLevel])
  @@index([organizationId, status])
  @@index([organizationId, subject])
}

model ClassroomStudent {
  classroomId String
  userId      String
  joinedAt    DateTime  @default(now())
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classroomId, userId])
  @@index([userId])
}

model ClassroomTeacher {
  classroomId String
  userId      String
  isPrimary   Boolean   @default(false)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classroomId, userId])
  @@index([userId])
}

model StudentProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  gradeLevel    String?
  bio           String?
  learningStyle String?
  preferredPace String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gradeLevel])
}

model TutoringBooking {
  id                   String                @id @default(cuid())
  customerId           String
  tutorId              String
  tutoringSlotId       String                @unique
  subject              String
  gradeLevel           String
  topic                String?
  description          String?
  amount               Int
  currency             String                @default("usd")
  status               TutoringBookingStatus @default(PENDING_PAYMENT)
  stripeSessionId      String?               @unique
  paymentIntentId      String?
  stripeSubscriptionId String?
  appointmentId        String?               @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  customer             User                  @relation("TutoringBookingCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  tutor                User                  @relation("TutoringBookingTutor", fields: [tutorId], references: [id], onDelete: Cascade)
  tutoringSlot         TutoringSlot          @relation(fields: [tutoringSlotId], references: [id])

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([tutorId, createdAt])
  @@index([tutorId, status])
}

model TutoringSlot {
  id              String           @id @default(cuid())
  tutorId         String
  startTime       DateTime
  endTime         DateTime
  status          SlotStatus       @default(Available)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  appointment     Appointment?
  tutoringBooking TutoringBooking?
  tutor           User             @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([tutorId, startTime, endTime])
  @@index([tutorId, startTime])
  @@index([tutorId, status, startTime])
}

model GuestTutoringCheckout {
  id                       String    @id @default(cuid())
  name                     String
  email                    String
  phoneNumber              String?
  gradeLevel               String
  subject                  String
  topic                    String?
  description              String?
  educatorId               String
  serviceId                String
  availabilityId           String
  startTime                DateTime
  endTime                  DateTime
  amount                   Int
  currency                 String    @default("usd")
  stripeSessionId          String?   @unique
  paymentIntentId          String?
  studentId                String?
  bookingId                String?
  status                   String    @default("PENDING")
  accountCreatedByCheckout Boolean   @default(false)
  accountSetupEmailSentAt  DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([email])
  @@index([status, createdAt])
  @@index([educatorId, startTime, endTime])
  @@index([availabilityId, startTime, endTime])
}

model LearningActivity {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  activityType String @default("RESOURCE_USE")
  status       String @default("STARTED")

  score    Float?
  maxScore Float?

  answers  Json?
  metadata Json?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model TutorReview {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  learnerId  String
  educatorId String
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  learner  User    @relation("TutorReviewLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  educator User    @relation("TutorReviewEducator", fields: [educatorId], references: [id], onDelete: Cascade)

  @@index([educatorId, createdAt])
  @@index([learnerId, createdAt])
}

model TutoringSession {
  id String @id @default(cuid())

  bookingId String @unique

  learnerId  String
  educatorId String
  serviceId  String?

  scheduledStart DateTime
  scheduledEnd   DateTime

  startedAt DateTime?
  endedAt   DateTime?

  status TutoringSessionStatus @default(SCHEDULED)

  learnerAttendance  Boolean?
  educatorAttendance Boolean?

  topic         String?
  topicsCovered Json?

  strengths     String? @db.Text
  needsPractice String? @db.Text
  nextStep      String? @db.Text
  tutorNotes    String? @db.Text

  learnerOutcome String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  learner  User     @relation("LearnerTutoringSessions", fields: [learnerId], references: [id], onDelete: Cascade)
  educator User     @relation("EducatorTutoringSessions", fields: [educatorId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id])

  @@index([learnerId, scheduledStart])
  @@index([educatorId, scheduledStart])
  @@index([status, scheduledStart])
}

model DailyChallenge {
  id String @id @default(cuid())

  // A challenge is assigned to a specific calendar date.
  challengeDate DateTime @db.Date
  gradeLevel    String
  subject       String   @default("Mathematics")
  topic         String
  difficulty    String   @default("MEDIUM")

  // Question content
  title         String
  question      String  @db.Text
  options       Json
  correctAnswer String
  hint          String? @db.Text
  explanation   String  @db.Text

  // Scoring and publication
  points      Int       @default(100)
  status      String    @default("DRAFT")
  publishedAt DateTime?

  createdById String?
  createdBy   User?                   @relation("DailyChallengeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attempts    DailyChallengeAttempt[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  // One challenge per grade, subject and date.
  @@unique([challengeDate, gradeLevel, subject])
  @@index([status, challengeDate])
  @@index([gradeLevel, challengeDate])
  @@index([subject, challengeDate])
}

model DailyChallengeAttempt {
  id String @id @default(cuid())

  challengeId String
  userId      String
  answer      String         @db.Text
  isCorrect   Boolean
  score       Int            @default(0)
  submittedAt DateTime       @default(now())
  challenge   DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  learner     User           @relation("DailyChallengeAttemptLearner", fields: [userId], references: [id], onDelete: Cascade)

  // One submission per learner per challenge.
  @@unique([challengeId, userId])
  @@index([challengeId, score, submittedAt])
  @@index([userId, submittedAt])
}

enum PaymentProductType {
  FLEXPAY_30_MIN
  FLEXPAY_45_MIN
  FLEXPAY_60_MIN
  MONTHLY_PREMIUM
}

enum PaymentPurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model PaymentPurchase {
  id                      String                @id @default(cuid())
  userId                  String
  productType             PaymentProductType
  status                  PaymentPurchaseStatus @default(PENDING)
  amount                  Int
  currency                String                @default("usd")
  sessionMinutes          Int?
  sessionsIncluded        Int                   @default(0)
  stripeCheckoutSessionId String?               @unique
  stripePaymentIntentId   String?
  stripeSubscriptionId    String?
  stripeInvoiceId         String?               @unique
  paidAt                  DateTime?
  metadata                Json?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  creditGrant             SessionCreditGrant?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([stripeSubscriptionId])
}

model Membership {
  id                   String               @id @default(cuid())
  userId               String
  stripeSubscriptionId String               @unique
  stripePriceId        String?
  status               String
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean              @default(false)
  canceledAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  creditGrants         SessionCreditGrant[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([currentPeriodEnd])
}

enum TutoringSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ============================================================
// JUSTDY CANONICAL RESOURCE SYSTEM — PHASE 1
// ============================================================

enum ClassroomStatus {
  ACTIVE
  ARCHIVED
}

enum TutoringBookingStatus {
  PENDING_PAYMENT
  PAID
  SCHEDULED
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  REFUNDED
}

enum ServiceType {
  TUTORING
  GROUP_CLASS
  COURSE
  CONSULTATION
  OTHER
}

enum ServiceStatus {
  Draft
  Published
  Archived
}

enum BookingStatus {
  Scheduled
  PendingPayment
  Completed
  Cancelled
  NoShow
}

enum UserStatus {
  Active
  Suspended
  Pending
  Deleted
}

enum VerificationStatus {
  Pending
  Verified
  Rejected
}

enum SlotStatus {
  Available
  Booked
  Blocked
}

enum AppointmentStatus {
  Scheduled
  Completed
  Cancelled
  Pending_payment
}

enum PayoutStatus {
  Unpaid
  Processing
  Paid
}

enum TransactionStatus {
  Pending
  Paid
  Failed
}

enum PendingEnrollmentStatus {
  Pending
  Enrolled
  Cancelled
}

enum EnrollmentTrack {
  Hourly
  Monthly
}

enum CurrencyType {
  USD
  GHS
}

enum GradeLevel {
  Grade1
  Grade2
  Grade3
  Grade4
  Grade5
  Grade6
  Grade7
  Grade8
  Grade9
  Grade10
  Grade11
  Grade12
}

enum PlatformRole {
  ADMIN
  TUTOR
  LEARNER
}

enum SessionCreditGrantStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  REVOKED
}

model SessionCreditGrant {
