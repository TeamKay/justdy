  guardianId       String
  learnerId        String
  status           GuardianLinkStatus @default(PENDING)
  relationship     String?
  consentGrantedAt DateTime?
  verifiedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  guardian User @relation("GuardianLinkGuardian", fields: [guardianId], references: [id], onDelete: Cascade)
  learner  User @relation("GuardianLinkLearner", fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([guardianId, learnerId])
  @@index([learnerId, status])
  @@index([guardianId, status])
  @@map("guardian_link")
}

// ============================================================
// PERSONAL INVESTMENT TRACKER
// ============================================================

enum InvestmentAccountProvider {
  FIDELITY
  BANK_OF_GHANA
  GHANA_STOCK_EXCHANGE
  STANBIC
  MANUAL
  OTHER
}

enum InvestmentAccountType {
  ROTH_IRA
  TAXABLE_BROKERAGE
  TREASURY_BILLS
  STOCKS
  MUTUAL_FUND
  CASH
  OTHER
}

enum InvestmentAssetType {
  STOCK
  ETF
  MUTUAL_FUND
  TREASURY_BILL
  CASH
  OTHER
}

enum InvestmentTransactionType {
  CONTRIBUTION
  DEPOSIT
  BUY
  SELL
  DIVIDEND
  INTEREST
  FEE
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  MATURITY
  REINVESTMENT
  ADJUSTMENT
}

enum InvestmentImportStatus {
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum TreasuryBillStatus {
  ACTIVE
  MATURED
  REDEEMED
  CANCELLED
}

model InvestmentProfile {
  id           String       @id @default(cuid())
  userId       String       @unique
  baseCurrency CurrencyType @default(USD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts      InvestmentAccount[]
  assets        InvestmentAsset[]
  snapshots     InvestmentPortfolioSnapshot[]
  importBatches InvestmentImportBatch[]

  @@map("investment_profile")
}

model InvestmentAccount {
  id           String                    @id @default(cuid())
  profileId    String
  name         String
  provider     InvestmentAccountProvider
  type         InvestmentAccountType
  currency     CurrencyType
  country      String
  notes        String?                   @db.Text
  isActive     Boolean                   @default(true)
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       InvestmentProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transactions  InvestmentTransaction[]
  importBatches InvestmentImportBatch[]

  @@index([profileId, isActive])
  @@index([provider])
  @@map("investment_account")
}

model InvestmentAsset {
  id             String              @id @default(cuid())
  profileId      String
  name           String
  symbol         String?
  assetType      InvestmentAssetType
  currency       CurrencyType
  exchange       String?
  externalSymbol String?
  isActive       Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile      InvestmentProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transactions InvestmentTransaction[]
  prices       InvestmentPriceHistory[]
  treasuryBill InvestmentTreasuryBill?

  @@unique([profileId, symbol])
  @@index([profileId, assetType])
  @@index([symbol])
  @@map("investment_asset")
}

model InvestmentTransaction {
  id            String  @id @default(cuid())
  accountId     String
  assetId       String?
  importBatchId String?

  type       InvestmentTransactionType
  occurredAt DateTime
  currency   CurrencyType

  // Amounts use decimal arithmetic rather than floating-point values.
  // Amount represents the transaction's absolute monetary amount.
  amount    Decimal  @db.Decimal(20, 8)
  quantity  Decimal? @db.Decimal(28, 10)
  unitPrice Decimal? @db.Decimal(20, 8)
  fees      Decimal  @default(0) @db.Decimal(20, 8)

  externalId  String?
  description String? @db.Text
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account     InvestmentAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset       InvestmentAsset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  importBatch InvestmentImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([accountId, externalId])
  @@index([accountId, occurredAt])
  @@index([assetId, occurredAt])
  @@index([type, occurredAt])
  @@map("investment_transaction")
}

model InvestmentPriceHistory {
  id          String       @id @default(cuid())
  assetId     String
  priceDate   DateTime     @db.Date
  price       Decimal      @db.Decimal(20, 8)
  currency    CurrencyType
  source      String
  isEstimated Boolean      @default(false)

  createdAt DateTime @default(now())

  asset InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, priceDate, source])
  @@index([assetId, priceDate])
  @@map("investment_price_history")
}

model InvestmentExchangeRate {
  id            String       @id @default(cuid())
  baseCurrency  CurrencyType
  quoteCurrency CurrencyType
  rateDate      DateTime     @db.Date
  rate          Decimal      @db.Decimal(20, 10)
  source        String
  createdAt     DateTime     @default(now())

  @@unique([baseCurrency, quoteCurrency, rateDate, source])
  @@index([rateDate])
  @@map("investment_exchange_rate")
}

model InvestmentTreasuryBill {
  id           String   @id @default(cuid())
  assetId      String   @unique
  purchaseDate DateTime @db.Date
  maturityDate DateTime @db.Date

  purchasePrice   Decimal  @db.Decimal(20, 8)
  faceValue       Decimal  @db.Decimal(20, 8)
  annualizedYield Decimal? @db.Decimal(12, 8)

  status         TreasuryBillStatus @default(ACTIVE)
  redeemedAt     DateTime?
  actualProceeds Decimal?           @db.Decimal(20, 8)
  notes          String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([status, maturityDate])
  @@map("investment_treasury_bill")
}

model InvestmentPortfolioSnapshot {
  id           String       @id @default(cuid())
  profileId    String
  snapshotDate DateTime     @db.Date
  baseCurrency CurrencyType
  totalValue   Decimal      @db.Decimal(24, 8)

  // Stores account-level valuation details for historical reporting.
  accountValues Json
  metadata      Json?

  createdAt DateTime @default(now())

  profile InvestmentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, snapshotDate, baseCurrency])
  @@index([profileId, snapshotDate])
  @@map("investment_portfolio_snapshot")
}

model InvestmentImportBatch {
  id        String                 @id @default(cuid())
  profileId String
  accountId String?
  fileName  String?
  source    String
  status    InvestmentImportStatus @default(PROCESSING)

  totalRows    Int   @default(0)
  importedRows Int   @default(0)
  skippedRows  Int   @default(0)
  failedRows   Int   @default(0)
  errorDetails Json?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  profile      InvestmentProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account      InvestmentAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transactions InvestmentTransaction[]

  @@index([profileId, createdAt])
  @@index([status])
  @@map("investment_import_batch")
}

