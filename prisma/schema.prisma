  targetId    String
  action      SocialModerationActionType
  reason      String?                    @db.Text
  metadata    Json?
  createdAt   DateTime                   @default(now())

  moderator User @relation("SocialModerationActor", fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt])
  @@index([moderatorId, createdAt])
  @@map("social_moderation_action")
}

model GuardianLink {
